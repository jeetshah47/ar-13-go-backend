                      "data": {
                        "id": "section2_approval_process",
                        "title": "Approval Process",
                        "content": "All leave requests must be submitted at least 7 days in advance. Requests are reviewed by the project manager or admin. Emergency leave requests can be submitted with shorter notice.",
