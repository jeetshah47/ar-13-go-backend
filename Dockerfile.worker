# Dockerfile for background worker - expects pre-built binary
FROM alpine:latest

# Install ca-certificates for HTTPS support
RUN apk --no-cache add ca-certificates

# Create non-root user
RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

# Create necessary directories
RUN mkdir -p /app && \
    chown -R appuser:appuser /app

# Set working directory
WORKDIR /app

# Copy pre-built binary from build directory
# Expects binary to be built as: bin/worker (or worker in project root)
COPY bin/worker worker
RUN chmod +x worker && \
    chown appuser:appuser worker

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Health check (worker doesn't have HTTP endpoint, so we check if process is running)
HEALTHCHECK --interval=60s --timeout=10s --start-period=10s --retries=3 \
  CMD ps aux | grep -v grep | grep worker > /dev/null || exit 1

# Run the worker
CMD ["./worker"]
