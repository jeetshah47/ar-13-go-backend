# AR-13 Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - it contains sensitive information

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# MongoDB Configuration (REQUIRED)
# ============================================
# MongoDB connection string
# Example: mongodb://username:password@host:27017/database?authSource=admin
# Or: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ar13_backend

# ============================================
# JWT Configuration (REQUIRED)
# ============================================
# Generate a strong secret key (at least 32 characters)
# You can generate one using: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24
REFRESH_EXPIRATION_DAYS=30

# ============================================
# Redis Configuration
# ============================================
# Redis address (use 'redis' as hostname when using docker-compose Redis service)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=your-redis-password-here
REDIS_DB=0
REDIS_PORT=6379

# ============================================
# Email Configuration (Optional but recommended)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=AR-13 System

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# Google OAuth Configuration (Optional)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# MinIO/NAS Storage Configuration (Optional)
# ============================================
MINIO_ENDPOINT=minio.example.com
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=ar-13-uploads
MINIO_USE_SSL=false
MINIO_INSECURE_SSL=false

# ============================================
# FileBrowser Configuration (Optional)
# ============================================
FILEBROWSER_ENABLED=false
FILEBROWSER_URL=http://localhost:8080
FILEBROWSER_TOKEN=
FILEBROWSER_SERVICE_URL=http://localhost:8082

# ============================================
# QNAP NAS Integration (Optional)
# ============================================
QNAP_NAS_IP=192.168.1.100
QNAP_API_PORT=8080
QNAP_SERVICE_USER=your-qnap-username
QNAP_SERVICE_PASSWORD=your-qnap-password
QNAP_SHARE_NAME=studio-work
QNAP_SESSION_TIMEOUT=30

